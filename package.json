{
  "name": "nody",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ./dev.sh",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:migrate:local": "wrangler d1 migrations apply nody-db --local --config worker/wrangler.jsonc",
    "worker:check": "wrangler check --config worker/wrangler.jsonc",
    "worker:types": "wrangler types worker/src/env.d.ts --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.18.0",
    "next": "^15.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@cloudflare/workers-types": "^4.20250303.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^4.11.1"
  }
}
