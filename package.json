{
  "name": "nody",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash ./dev.sh",
    "dev:cloud": "NODY_DEV_ENV_FILE=.env.deploy NODY_DEV_WORKER_BINDINGS_MODE=remote bash ./dev.sh --remote-bindings",
    "build": "rm -rf .next && next build",
    "start": "next start",
    "preview:direct": "set -a; . ./.env.deploy; set +a; opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:direct": "set -a; . ./.env.deploy; set +a; opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload:direct": "set -a; . ./.env.deploy; set +a; opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "preview": "bash ./scripts/deploy-from-worktree.sh preview:direct",
    "deploy": "bash ./scripts/deploy-from-worktree.sh deploy:direct",
    "upload": "bash ./scripts/deploy-from-worktree.sh upload:direct",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker:migrate:local": "wrangler d1 migrations apply nody-db --local --config worker/wrangler.jsonc",
    "worker:migrate:remote": "set -a; . ./.env.deploy; set +a; wrangler d1 migrations apply nody-db --remote --config worker/wrangler.jsonc",
    "worker:check": "set -a; . ./.env.deploy; set +a; wrangler deploy --dry-run --config worker/wrangler.jsonc --experimental-autoconfig=false",
    "worker:deploy": "set -a; . ./.env.deploy; set +a; wrangler deploy --config worker/wrangler.jsonc --experimental-autoconfig=false",
    "worker:types": "wrangler types worker/src/env.d.ts --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.18.0",
    "@opennextjs/cloudflare": "^1.19.1",
    "next": "15.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^4.11.1"
  }
}
